{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quickmail",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,

	// Your account ID filled in
	"account_id": "5b49642f856e69ac463af10e6da43323",

	// (Optional) Uncomment and fill if you are using a custom domain instead of workers.dev
	// "routes": [
	// 	{
	// 		"pattern": "mail.yourdomain.com",
	// 		"custom_domain": true
	// 	}
	// ],

	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},

	// Change provider to cloudflare and specify your domain
	"vars": {
		"EMAIL_PROVIDER": "cloudflare",
		"CLOUDFLARE_MAIL_DOMAINS": "genofx.com"
	},

	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quickmail",
			// Put your actual D1 database ID here after running `wrangler d1 create quickmail`
			"database_id": "ce6bd9f0-dae7-44c2-a19e-6cc7cfe61d3c",
			"migrations_dir": "migrations"
		}
	],

	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "quickmail-attachments"
		}
	],

	"observability": {
		"enabled": true
	}
}
